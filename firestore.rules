rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email == 'caddyquivo@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 200 &&
             data.type is string && (data.type == 'ebook' || data.type == 'video') &&
             data.price is number && data.price >= 0 &&
             data.sellerEmail is string && data.sellerEmail.size() <= 128;
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isSignedIn() && isValidId(productId) && isValidProduct(incoming()) && (
        (request.auth.token.email != null && incoming().sellerEmail == request.auth.token.email) ||
        isAdmin()
      );
      allow update: if isSignedIn() && isValidId(productId) && isValidProduct(incoming()) && (
        (request.auth.token.email != null && existing().sellerEmail == request.auth.token.email) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && isValidId(productId) && (
        (request.auth.token.email != null && existing().sellerEmail == request.auth.token.email) ||
        isAdmin()
      );
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (
        resource.data.buyerEmail == request.auth.token.email ||
        resource.data.sellerEmail == request.auth.token.email ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.buyerEmail == request.auth.token.email ||
        resource.data.sellerEmail == request.auth.token.email ||
        isAdmin()
      );
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
